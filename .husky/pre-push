# Chain the beads shim. Git honours core.hooksPath (.husky/_), so the copy
# beads installs into .git/hooks is never reached; run it from here instead.
# Skip silently when the shim is absent — a sparse checkout or a repo that
# has dropped beads must still be able to push. stdin carries the refs
# being pushed and is inherited as-is.
hook="$(git rev-parse --show-toplevel)/.beads/hooks/pre-push"
[ -x "$hook" ] || exit 0
"$hook" "$@"

# The shim does not sync the issue database — it only handles backup and
# export, both of which it skips under a git hook. Pushing the Dolt data to
# refs/dolt/data is a separate command that nothing else calls, and without
# it the bead state never leaves this machine.
command -v bd >/dev/null 2>&1 || exit 0

# Only for the remote beads actually syncs against, so `git push fork`
# does not quietly push issues to origin.
target=$(git remote get-url "$1" 2>/dev/null || echo "$1")
origin=$(git remote get-url origin 2>/dev/null || echo)
[ -n "$origin" ] && [ "$target" = "$origin" ] || exit 0

# Suppress the marker branch. Alongside the data at refs/dolt/data, dolt
# force-pushes a human-readable branch holding a single DOLT_REMOTE.md — at
# refs/heads/__dolt_remote_info__, so GitHub treats it as a real branch and
# shows a "had recent pushes" banner after every push. Setting the branch
# name to empty disables that push entirely (dolt's ResolveInfoBranch); the
# data plane is untouched, since it never rides on this ref. Exported so any
# bd invocation below inherits it. See gis-v3t.
export DOLT_REMOTE_INFO_BRANCH=

# Bounded: a black-holed network must not hang the push. Warn rather than
# fail — being offline should not block a push, and the next one retries.
if command -v timeout >/dev/null 2>&1; then
  out=$(timeout 60 bd dolt push 2>&1); code=$?
elif command -v gtimeout >/dev/null 2>&1; then
  out=$(gtimeout 60 bd dolt push 2>&1); code=$?
else
  out=$(bd dolt push 2>&1); code=$?
fi
guard="$(git rev-parse --show-toplevel)/scripts/beads-sync-guard.sh"
if [ $code -eq 0 ]; then
  [ -f "$guard" ] && sh "$guard" success
  exit 0
fi

echo >&2 "beads: could not sync the issue database to $1:"
echo >&2 "$out" | sed 's/^/  /'

# One warning was the whole bug. An offline push should still go through, so
# the first failures stay advisory — but they are counted, and once the count
# says this is not a passing network blip, the push stops rather than letting
# the two sides drift further apart in silence. See gis-apr.
[ -f "$guard" ] || exit 0
fails=$(sh "$guard" failure "$out")
limit=${BEADS_PUSH_FAIL_LIMIT:-3}
if [ "$fails" -lt "$limit" ] || [ "${BEADS_ALLOW_UNSYNCED:-}" = 1 ]; then
  echo >&2 "beads: the bead state stays local until 'bd dolt push' succeeds ($fails/$limit)."
  exit 0
fi

echo >&2 "beads: STOPPING THE PUSH — that is $fails failures in a row."
echo >&2 "beads: the code would land on the remote while the issues behind it stay"
echo >&2 "beads: on this machine only, and every further commit widens the gap."
echo >&2 "beads: run 'bd dolt pull' and then 'DOLT_REMOTE_INFO_BRANCH= bd dolt push'."
echo >&2 "beads: if the pull reports a merge conflict, stop and report it."
echo >&2 "beads: to push the code anyway: BEADS_ALLOW_UNSYNCED=1 git push ..."
exit 1
